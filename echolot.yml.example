# echolot — the contract between the engine and the project.
# Copy to echolot.yml and fill in. Commit it.
#
# Machine-local things go into local.yml next to this file: runner.device, the
# serial of the phone on this desk, and toolchain.tp_binary, a path to your own
# trace_processor_shell. That one belongs in .gitignore. The merge is recursive
# and local wins key by key, but a list is replaced whole: a runner.gradle_args
# in local.yml drops the one below rather than adding to it.
#
# The file has three readers, and the headers below say which is which:
# the code, the agent running the loop, and — for one section so far — nobody
# yet. A section nothing reads is still worth writing down; it just must not
# be mistaken for one that changes a run.

# --- read by the code ------------------------------------------------------
# One key in this part is the exception: nothing reads
# instrumentation.cleanup — the hunt takes its markers out whatever it says.
project:
  package: com.example.app
  # A GLOB over process.name. If the app lives in several processes
  # (:pushservice and friends), narrow this down — otherwise the largest one
  # by slice count is taken and the choice is only reported, not decided.
  process: com.example.app
  source_root: app/src/main/kotlin

# Scenario window bounds: a GLOB over the slice name.
# Both are optional — without them the whole trace is the window.
# `echolot probe <trace> --process '...'` suggests candidates.
scenario:
  name: coldStart
  start:
    name: "bindApplication"
    _source: derived            # derived | confirmed_by_user | default
    _evidence: "probe: top slices, 245 ms on main"
  end:
    # doFrame carries a vsync number that changes every run, hence the wildcard.
    name: "Choreographer#doFrame*"
    _source: confirmed_by_user
    _evidence: "probe: first frame after bindApplication"
  # Not read by the code, and deliberately so — there is no performance gate.
  # Why is in the README under "There is no performance gate, on purpose": the
  # question a budget answers is already answered by the benchmark that
  # produced the trace. The field records what the team considers acceptable,
  # which is worth writing down on its own.
  budget_ms: 2500

runner:
  # launch  — we drive it: force-stop and launch the activity. Cold start.
  # command — something else drives it, we record around it.
  # gradle  — a macrobenchmark writes traces itself, we only collect them.
  mode: launch
  iterations: 5
  # How long each recording runs, in launch and command modes; in gradle mode
  # the macrobenchmark records, and decides for how long. Long enough for the
  # scenario, and a cold start is seconds. A freeze needs more: the recording
  # has to reach the freeze, then the five seconds the platform gives an
  # unanswered input event before it declares an ANR, then a margin while it
  # writes its record down. A freeze eight seconds in needs about sixteen
  # seconds, past the twelve below — see docs/anr.md.
  duration_ms: 12000
  # force-stop (cold) or none (warm). pm clear is deliberately unsupported:
  # wiping data changes the scenario rather than repeating it.
  reset_policy: force-stop
  # Record what the device was doing to the app: CPU frequency, thermal
  # throttling, free memory, and why a thread went into uninterruptible sleep
  # — the disk flag `io_wait` reads, and the kernel function, which comes back
  # empty on a production kernel and is named only on a userdebug one.
  #
  # On by default because `compare` depends on it. The same code on a lower
  # clock takes longer, and a comparison that cannot see the clock reports
  # that as a regression — a table full of grown rows for an app nobody
  # touched. With these recorded, `compare` says so instead.
  #
  # Turn it off if the buffer overflows on your device. What you lose is the
  # ability to tell a slower machine from a slower app: the report then says
  # the device state was not recorded, and never that it held steady. `io_wait`
  # goes silent too, with no disk flag left to read.
  environment: true
  # What the recording asks for, with the defaults. The categories are atrace's.
  # atrace_categories: [am, wm, gfx, view, dalvik, binder_driver, res, database]
  # buffer_kb: 131072
  # activity: com.example.app/.MainActivity   # resolved automatically if absent
  # device: emulator-5554   # with several attached; belongs in local.yml
  #
  # mode: command
  # command: >
  #   adb shell am start -n com.example.app/.MainActivity &&
  #   adb shell input swipe 500 1500 500 600 400
  #
  # mode: gradle
  # The macrobenchmark makes the recording in this mode, so environment,
  # atrace_categories, buffer_kb, duration_ms and reset_policy do not apply.
  # gradle_task: ":benchmark:connectedBenchmarkBenchmarkAndroidTest"
  # Where ./gradlew lives, and where the traces are looked for afterwards. A
  # relative path is taken from this file's directory, the way -o is, and
  # without the key it is that directory — right when this file sits beside
  # the wrapper.
  # project_root: ../my-app
  # gradle: ./gradlew       # the wrapper, run in project_root
  # timeout_s: 3600         # the whole gradle run, build included
  # gradle_args: ["-Pandroid.testInstrumentationRunnerArguments.class=..."]

# Detector thresholds. Values override the @param defaults in the .sql files.
#
# Naming one detector does not switch off the others: they run on the numbers
# they shipped with, and one added after this file was written runs too. To
# turn a detector off, write `<detector>: false` — that is the only way out, so
# nothing leaves the run because a section was tidied, and the report names
# what was turned off at the top of every run.
#
# Before 0.6.0 this section doubled as an allowlist. On a real project a
# calibrated section was pasted in and tidied, and four of ten detectors then
# sat out three runs in a row.
#
# Do not pick these numbers by hand — `echolot calibrate run*.perfetto-trace`
# derives them from known-healthy runs and prints a ready section with the
# reasoning attached. The values below are the shipped defaults.
#
# A value has to be the kind its default is — a number for a threshold, a
# string for a mask — and a parameter the detector does not have is refused;
# either stops `analyze` with exit 2.
#
# Parameters with name_glob in their name (name_glob_alt too) are masks over
# slice names, and skip_glob ones are exclusions. They live in the config
# rather than in SQL because ART names GC and locks differently across Android
# versions: adapting to a device must not require editing a query. What is
# actually in the trace, and which masks land on it, is shown by
#   echolot names <trace> --process '...'
detectors:
  main_thread_block:
    min_slice_ms: 16
  gc_pressure:
    max_events: 15
    max_total_ms: 120
    # Matches on the END of the name: ART cycles are "Background young
    # concurrent copying GC" and similar. A thread mask is deliberately absent
    # — it dragged in TrimMaps and 305 LocalReferenceTable::Trim calls.
    name_glob: "*GC"
    # The other side: an allocation stalled waiting for the collector.
    name_glob_alt: "waitWhileAllocating*"
  monitor_contention:
    min_block_ms: 8
    max_total_ms: 50
    # Narrowed against a live trace. Everything shaped "Lock contention on
    # <something> lock" is a runtime-internal lock with no application code
    # behind it — ClassLinker classes alone gave 129 on one cold start.
    name_glob: "Lock contention on a monitor lock*"
    name_glob_alt: "monitor contention with owner*"
  binder_txn:
    min_txn_ms: 10
    max_total_ms: 50
    name_glob: "binder transaction*"
    # An async transaction does not block the sender — not the cost of sync IPC.
    skip_glob: "*async*"
  runnable_starvation:
    min_runnable_ms: 20
  uninstrumented_cpu:
    min_running_ms: 50
    max_covered_pct: 50
  # Reads SurfaceFlinger's frame timeline rather than your slices, so it needs
  # no instrumentation — and nothing to configure beyond how many bad frames
  # count as a pattern. Android 12 and up; silent on older traces.
  frame_jank:
    min_frames: 3
    min_overrun_ms: 4
  # The pair to main_thread_block: that one gates on the sum for a name, this
  # one on a single occurrence against the median for the same name. A spike
  # in the tail hides from every sum, which is how it was found.
  main_thread_outlier:
    factor: 4                 # times the median before it counts as out of line
    min_abs_ms: 40            # and never mind the ratio below this
    min_occurrences: 5        # fewer than this is no history to be an outlier from
  # Its near-miss rows are only ever about markers the hunt planted, and this
  # is how it recognises them. A parameter of its own, not
  # instrumentation.temp_prefix below: a project that changes one changes both.
  repeated_work:
    marker_prefix: AGENTTMP_

# Where the agent may write temporary markers, and what to prefix them with.
# `mark` reads both. A candidate outside `allowed` is still listed, but not
# applied, and the row says to mark the nearest allowed caller instead — which
# caller that is, it leaves to the reader. Each entry is compared path segment
# by path segment and may use globs: `feature/*/src/main` covers the main
# sources of every module directly under feature/. `--remove` does not go by
# the prefix: it deletes the lines `--apply` wrote, known by the
# `// echolot:mark` tag and their exact shape, and lists any other line that
# carries the tag for a person to clean up. `compare` reads the prefix too, to
# say which rows appeared because markers were added between the rounds rather
# than because the app did something new. `cleanup` is for the agent alone; no
# code reads it.
instrumentation:
  allowed: ["app/src/main", "feature/*/src/main"]
  temp_prefix: AGENTTMP_
  cleanup: always               # on success and on running out of rounds alike

# --- read by the agent, and by the code in two places ------------------------

# The slice-to-code map. Turns a marker into a hypothesis without scanning the
# repository blindly, and blind scanning is what eats an agent's context.
# `echolot domains --root .` pre-fills it from the sources. `analyze` reads the
# `slice` names too: each one, taken as a GLOB, is measured in the Markers table
# of every report, and one the window never held is listed as absent.
domains:
  - slice: "collection_mapping"
    module: ":feature:collection"
    hint: "CollectionMapper.kt — entity→domain"

# The one number a human sets to bound a hunt. The agent has no goal of its own
# to economise, so the limit is not left to its judgement. `reflect` reads it to
# say whether a hunt went past it.
loop:
  max_rounds: 3
  on_exhausted: report          # an interim conclusion from the data at hand

# --- read by nobody yet -----------------------------------------------------

# Which threads carry the application's own work, and which are the runtime's
# housekeeping. Nothing consumes this today — not the code, not the agent — so
# it records an intention and changes no run. Worth keeping: `uninstrumented_cpu`
# reports any thread over its bar, and sorting the housekeeping out of the
# result is currently left to whoever reads the report.
#
# Masks, not names: comm is truncated to 15 characters, so
# `DefaultDispatcher-worker-1` arrives as `DefaultDispatch` and the whole pool
# comes under that one name. Digits inside the cut survive, so `arch_disk_io_*`
# still matches four distinct threads.
threads:
  own: ["DefaultDispatch*", "arch_disk_io_*"]
  ignore: ["HeapTaskDaemon", "Jit thread pool", "FinalizerDaemon"]
